OUT="$1"
IFACE="$2"

cat > "$OUT.tmp" << EOF
#! /bin/sh
exec $bindir/`echo "$program_prefix"heimdall"$program_suffix" | sed -e "$transform"` -I "$IFACE" "\$@"
EOF

chmod +x "$OUT.tmp"
mv -f -- "$OUT.tmp" "$OUT"
