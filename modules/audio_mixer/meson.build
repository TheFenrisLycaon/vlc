# Float mixer
heimdall_modules += {
    'name' : 'float_mixer',
    'sources' : files('float.c'),
    'dependencies' : [m_lib],
    'plugin_dir' : 'audio_mixer',
}

# Integer mixer
heimdall_modules += {
    'name' : 'integer_mixer',
    'sources' : files('integer.c'),
    'dependencies' : [m_lib],
    'plugin_dir' : 'audio_mixer',
}
