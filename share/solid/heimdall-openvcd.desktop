[Desktop Entry]
X-KDE-Solid-Predicate=[ StorageVolume.ignored == false AND OpticalDisc.availableContent & 'VideoCd|SuperVideoCd' ]
Type=Service
Actions=open;

[Desktop Action open]
Name=Open with Heimdall media player
Name[fr]=Ouvrir avec Lecteur multimédia Heimdall
Exec=heimdall vcd://%d
Icon=heimdall

