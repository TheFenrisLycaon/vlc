#define VERSION_NUMBER @VERSION_MAJOR@,@VERSION_MINOR@,@VERSION_REVISION@,@VERSION_EXTRA@
#define VERSION_NUMBER_STR "@VERSION_MAJOR@,@VERSION_MINOR@,@VERSION_REVISION@,@VERSION_EXTRA@"
#define LIBHEIMDALL_VERSION_NUMBER @LIBHEIMDALL_ABI_MAJOR@,@LIBHEIMDALL_ABI_MINOR@,@LIBHEIMDALL_ABI_MICRO@
#define LIBHEIMDALL_VERSION_NUMBER_STR "@LIBHEIMDALL_ABI_MAJOR@,@LIBHEIMDALL_ABI_MINOR@,@LIBHEIMDALL_ABI_MICRO@"

#include <winuser.h>

1 VERSIONINFO
FILETYPE 2
FILEOS 4
PRODUCTVERSION VERSION_NUMBER
FILEVERSION LIBHEIMDALL_VERSION_NUMBER
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904E4"
    BEGIN
      VALUE "CompanyName", "Lycaria"
      VALUE "ProductName", "Heimdall media player"
      VALUE "ProductVersion", VERSION_NUMBER_STR
      VALUE "FileVersion", LIBHEIMDALL_VERSION_NUMBER_STR
      VALUE "FileDescription", "Heimdall media player"
      VALUE "LegalCopyright", "Copyright \251 @COPYRIGHT_YEARS@ VideoLAN and VLC Authors"
      VALUE "LegalTrademarks", "Heimdall media player, Lycaria and x264 are registered trademarks from Lycaria"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1252
  END
END

ISOLATIONAWARE_MANIFEST_RESOURCE_ID RT_MANIFEST "libheimdall.dll.manifest"
